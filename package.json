{
  "name": "agentops",
  "version": "0.1.0",
  "private": true,
  "description": "AI-native observability platform for AI agent applications",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "observability",
    "agents",
    "llm",
    "monitoring",
    "copilot-sdk"
  ],
  "author": "Jose David Baena",
  "license": "MIT"
}
